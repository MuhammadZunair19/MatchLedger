# Copy to .env and supply a random URL-safe password; never commit .env.
POSTGRES_USER=matchledger
POSTGRES_PASSWORD=
POSTGRES_DB=matchledger
APP_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
SESSION_HOURS=12
# For native development; Compose supplies internal database/Redis URLs.
# DATABASE_URL=postgresql+psycopg://matchledger:YOUR_LOCAL_PASSWORD@localhost:5432/matchledger
REDIS_URL=redis://localhost:6379/0
DOCUMENT_STORAGE_PATH=../private_documents
MAX_UPLOAD_SIZE_MB=20
MAX_DOCUMENT_PAGES=30
MAX_IMAGE_PIXELS=25000000
DOCUMENT_PARSE_TIMEOUT=30
EXTRACTION_TIMEOUT=900
MAX_EXTRACTION_ATTEMPTS=5
OCR_DEVICE=cpu
OCR_LANGUAGES=en,ar
OCR_DPI=150
DATE_ORDER=DMY
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2:3b
